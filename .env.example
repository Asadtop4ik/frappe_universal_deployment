# ============================================
# FRAPPE DEPLOYMENT CONFIGURATION
# ============================================
# Bu faylni .env ga nusxalang va o'z qiymatlaringizni kiriting:
# cp .env.example .env
#
# ============================================
# CI/CD SETUP UCHUN MUHIM!
# ============================================
# GitHub Actions ishlatadigan bo'lsangiz:
#   1. Quyidagi qiymatlarni GitHub Secrets ga qo'shing
#   2. Repository → Settings → Secrets → Actions → New secret
#   3. .env faylni commit qilMANG! (security risk)
#
# Kerakli GitHub Secrets:
#   - SSH_PRIVATE_KEY (full SSH private key)
#   - SERVER_IP
#   - SITE_NAME
#   - DB_PASSWORD (MARIADB_ROOT_PASSWORD)
#   - ADMIN_PASSWORD
#   - APPS_TO_INSTALL (ixtiyoriy)
#
# Batafsil: CI_CD_SETUP.md faylini o'qing
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
SERVER_IP="your_server_ip"
SERVER_USER="root"

# ============================================
# FRAPPE/ERPNEXT CONFIGURATION
# ============================================
# Frappe user (odatda frappe)
FRAPPE_USER="frappe"

# Site nomi (masalan: mycompany.local yoki example.com)
SITE_NAME="mysite.local"

# Frappe/ERPNext version (masalan: version-15, version-14)
FRAPPE_VERSION="version-15"

# ============================================
# APPS CONFIGURATION
# ============================================
# O'rnatish kerak bo'lgan applar (vergul bilan ajratilgan)
# Masalan: "erpnext,hrms,custom_app"
# Faqat frappe kerak bo'lsa: "frappe"
APPS_TO_INSTALL="frappe,erpnext,hrms"

# Custom app GitHub URL (agar bo'lsa)
# Bo'sh qoldirsa, o'rnatilmaydi
# MUHIM: Custom app xato bersa ham base apps (ERPNext) ishlab turadi
CUSTOM_APP_REPO=""
# Masalan: CUSTOM_APP_REPO="https://github.com/user/custom_app.git"

# Custom app nomi (repo nomidan farq qilsa)
# Masalan: Agar repo "akfa_accounting.git" bo'lsa, app nomi "akfa_accounting"
CUSTOM_APP_NAME=""

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MariaDB root password (server da o'rnatish uchun)
MARIADB_ROOT_PASSWORD="YourSecurePassword123!"

# Site admin password
ADMIN_PASSWORD="admin"

# ============================================
# BACKUP CONFIGURATION
# ============================================
# Backup restore (deploy vaqtida)
# true = backupni avtomatik restore qiladi
# false = yangi bo'sh tizim yaratadi
RESTORE_BACKUP="false"

# Backup fayl nomlari (backups/ papkasida)
# Faqat RESTORE_BACKUP=true bo'lganda kerak
SQL_BACKUP_FILE=""
# Masalan: SQL_BACKUP_FILE="20260128_120000-site1_local-database.sql.gz"

# Ixtiyoriy: Private va Public files backup
PRIVATE_FILES_BACKUP=""
PUBLIC_FILES_BACKUP=""
# Masalan: PRIVATE_FILES_BACKUP="20260128_120000-site1_local-private-files.tar"

# ============================================
# AUTO BACKUP CONFIGURATION (Google Drive)
# ============================================
# Avtomatik backup (cron job)
# true = har kuni backup + Google Drive'ga yuklash
ENABLE_AUTO_BACKUP="false"

# Fayllarni ham backup qilish (private/public files)
# true = database + files, false = faqat database
BACKUP_WITH_FILES="true"

# Backuplarni necha kun saqlash (lokal va Google Drive)
BACKUP_RETENTION_DAYS="7"

# rclone remote nomi (rclone config da yaratgan nomingiz)
# Setup: rclone config → new → drive → ...
RCLONE_REMOTE="gdrive"

# Google Drive'dagi papka nomi
GDRIVE_BACKUP_FOLDER="frappe-backups"

# Backup vaqti (cron formatida)
# Namunalar:
#   "0 2 * * *"     = Har kuni soat 02:00
#   "0 */6 * * *"   = Har 6 soatda
#   "0 2 * * 0"     = Har yakshanba 02:00
BACKUP_CRON="0 2 * * *"

# ============================================
# PRODUCTION SETTINGS
# ============================================
# Developer mode (true/false)
# Production da false bo'lishi kerak
DEVELOPER_MODE="false"

# Scheduler enable qilish (true/false)
ENABLE_SCHEDULER="true"

# ============================================
# DOMAIN & SSL CONFIGURATION
# ============================================
# Deploy vaqtida SSL avtomatik sozlash
# true = deploy.sh ichida SSL ham sozlanadi
# false = keyinroq manual: sudo bash deploy/02-setup-domain-ssl.sh
SETUP_SSL="false"

# SSL domain (masalan: akfa.uz yoki erp.company.com)
# SETUP_SSL=true bo'lganda kerak
SSL_DOMAIN=""

# SSL email (Let's Encrypt uchun, certificate expiry notifications)
# SETUP_SSL=true bo'lganda kerak
SSL_EMAIL=""

# Domain setup steps:
# 1. DNS sozlang: A Record → SERVER_IP
# 2. DNS propagate bo'lguncha kuting (5-10 min)
# 3. SETUP_SSL=true qiling va deploy.sh ishga tushiring
#    YOKI keyinroq: sudo bash deploy/02-setup-domain-ssl.sh
#
# Batafsil: DIGITALOCEAN_SETUP.md

# ============================================
# ADVANCED SETTINGS
# ============================================
# Bench path (default: /home/frappe/frappe-bench)
BENCH_PATH="/home/${FRAPPE_USER}/frappe-bench"

# Python version (default: python3)
PYTHON_VERSION="python3"

# Node.js version (default: 20 LTS - recommended for 2026)
NODE_VERSION="20"

# ============================================
# OPTIONAL: CI/CD SETTINGS
# ============================================
# ESLATMA: Bu qiymatlar GitHub Actions da ishlatiladi
# Manual deploy uchun bu section ixtiyoriy
#
# GitHub Actions setup:
#   1. templates/github-workflow.yml ni copy qiling
#   2. .github/workflows/deploy.yml ga joylashtiring
#   3. GitHub Secrets configure qiling
#   4. Batafsil: CI_CD_SETUP.md
#
# ============================================

# Automatic deployment webhook URL (ixtiyoriy)
# Slack/Discord webhook uchun
WEBHOOK_URL=""

# Notification settings (ixtiyoriy)
NOTIFY_ON_SUCCESS="false"
NOTIFY_EMAIL=""
